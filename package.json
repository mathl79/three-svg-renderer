{
  "name": "three-svg-renderer",
  "description": "An experimental three.js SVG renderer written in Typescript to render 3D scenes as Vector Graphics.",
  "keywords": [
    "svg",
    "renderer",
    "three.js",
    "vector-graphics",
    "3D"
  ],
  "version": "1.0.4",
  "license": "GPLV3",
  "author": {
    "name": "Axel Antoine",
    "email": "ax.antoine@gmail.com",
    "url": "http://axantoine.com"
  },
  "type": "module",
  "main": "build/index.umd.js",
  "module": "build/index.esm.js",
  "types": "build/types/index.d.ts",
  "files": [
    "build",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LokiResearch/three-svg-renderer.git"
  },
  "scripts": {
    "build": "rollup -c",
    "build-examples": "rollup -c --environment examples",
    "build-doc": "typedoc src/index.ts",
    "dev": "rollup -cw",
    "dev-examples": "rollup -cw --environment examples",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "lint": "eslint src examples"
  },
  "peerDependencies": {
    "three": ">= 0.141.0"
  },
  "dependencies": {
    "@svgdotjs/svg.js": "^3.2.8",
    "@svgdotjs/svg.topath.js": "^2.0.4",
    "arrangement-2d-js": "github:LokiResearch/arrangement-2d-js",
    "fast-triangle-triangle-intersection": "^1.0.7",
    "flatbush": "^4.6.2",
    "isect": "^3.0.3",
    "opencv-ts": "^1.3.6",
    "three-mesh-bvh": "^0.9.15",
    "three-mesh-halfedge": "^1.0.3",
    "xml-formatter": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/dat.gui": "^0.7.13",
    "@types/estree": "^1.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@types/throttle-debounce": "^5.0.2",
    "dat.gui": "^0.7.9",
    "eslint": "^10.12.0",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "rollup": "^4.64.0",
    "rollup-plugin-generate-html-template": "^1.7.0",
    "three": "^0.186.1",
    "three-spritetext": "^1.10.0",
    "throttle-debounce": "^5.0.2",
    "ts-jest": "^29.4.14",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
